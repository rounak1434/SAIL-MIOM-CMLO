# Server Port
PORT=8000

# Base URL (for serving uploaded files)
BASE_URL=http://localhost:8000

# CORS Allowed Origins (comma-separated if multiple, include Firebase Hosting domains in production)
CORS_ORIGIN=http://localhost:5173,https://sail-miom-elect.web.app,https://sail-miom-elect.firebaseapp.com

# Database Connection URL (SQLite for local file persistence)
DATABASE_URL="file:./sail_kiom.db"

# JWT Secret Key (change this in production!)
JWT_SECRET=sail_kiom_super_secret_jwt_key_2026_dev_only

# JWT Expiration Duration
JWT_EXPIRES_IN=7d

# Environment
NODE_ENV=development
