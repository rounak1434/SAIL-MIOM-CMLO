rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS (Strict Authoritative Custom Claims)
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Super Admin strictly authorized via Firebase Auth custom claim only
    function isSuperAdmin() {
      return isAuthenticated() && ('superAdmin' in request.auth.token) && request.auth.token.superAdmin == true;
    }

    // Admin authorized via custom claim, Chief Admin, Super Admin, or verified Firestore admin profile
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'chief_admin' ||
        request.auth.token.role == 'CHIEF_ADMIN' ||
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'chief_admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CHIEF_ADMIN') &&
         (!('isActive' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive != false) &&
         (!('blocked' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blocked != true))
      );
    }

    // Chief Admin authorized via custom claim, Super Admin, or verified Firestore chief_admin profile
    function isChiefAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'chief_admin' ||
        request.auth.token.role == 'CHIEF_ADMIN' ||
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'chief_admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CHIEF_ADMIN') &&
         (!('isActive' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive != false) &&
         (!('blocked' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blocked != true))
      );
    }

    // Moderator authorized via custom claim, Admin, Chief Admin, Super Admin, or verified Firestore moderator profile
    function isModerator() {
      return isAuthenticated() && (
        request.auth.token.role == 'moderator' ||
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'moderator' &&
         (!('isActive' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive != false) &&
         (!('blocked' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blocked != true))
      );
    }

    // System license check for write operations
    function isLicenseExpired() {
      return exists(/databases/$(database)/documents/systemSettings/serviceLicense) &&
             get(/databases/$(database)/documents/systemSettings/serviceLicense).data.enabled == true &&
             request.time >= get(/databases/$(database)/documents/systemSettings/serviceLicense).data.expiresAt;
    }

    // Helper to identify Super Admin accounts across Firestore doc attributes and trusted registry
    function isSuperAdminAccount(userId) {
      return (('superAdmin' in resource.data) && resource.data.superAdmin == true) ||
             (('role' in resource.data) && resource.data.role == 'super_admin') ||
             (exists(/databases/$(database)/documents/systemSettings/superAdminRegistry) &&
              userId in get(/databases/$(database)/documents/systemSettings/superAdminRegistry).data.uids);
    }

    // Helper to identify if the authenticated caller's account is marked as hidden
    function isCallerHidden() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             ('hidden' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.hidden == true;
    }

    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      // GET: Direct document lookup
      // - Users can read their own profile (including Super Admin)
      // - Super Admin can read any profile
      // - Admins & Chief Admins can read any non-Super Admin, non-hidden profile
      // - Moderators can read any non-Super Admin, non-hidden moderator profile
      allow get: if isAuthenticated() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (isAdmin() && !isSuperAdminAccount(userId) && (!('hidden' in resource.data) || resource.data.hidden != true)) ||
        (resource.data.role == 'moderator' && isModerator() && !isSuperAdminAccount(userId) && (!('hidden' in resource.data) || resource.data.hidden != true))
      );

      // LIST: Collection queries
      // - Super Admin can list all users directly
      // - Chief Admin can query non-hidden Chief Admin, Admin, and Moderator accounts
      // - Admin can query non-hidden Admin and Moderator accounts
      // - Moderator can query non-hidden Moderator accounts
      allow list: if isAuthenticated() && (
        isSuperAdmin() ||
        (isChiefAdmin() &&
         resource.data.role in ['chief_admin', 'CHIEF_ADMIN', 'admin', 'moderator'] &&
         (!('hidden' in resource.data) || resource.data.hidden != true) &&
         (!('superAdmin' in resource.data) || resource.data.superAdmin != true) &&
         resource.data.role != 'super_admin') ||
        (isAdmin() &&
         resource.data.role in ['admin', 'moderator'] &&
         (!('hidden' in resource.data) || resource.data.hidden != true) &&
         (!('superAdmin' in resource.data) || resource.data.superAdmin != true) &&
         resource.data.role != 'super_admin') ||
        (isModerator() &&
         resource.data.role == 'moderator' &&
         (!('hidden' in resource.data) || resource.data.hidden != true) &&
         (!('superAdmin' in resource.data) || resource.data.superAdmin != true) &&
         resource.data.role != 'super_admin')
      );

      // CREATE:
      // - Regular users create own profile on registration strictly with role='user'
      // - Chief Admin can create Admin, Chief Admin, and Moderator accounts
      // - Admin can create Moderator and user accounts
      // - Lower roles can NEVER create accounts with superAdmin=true, hidden=true, or role='super_admin'
      allow create: if isAuthenticated() && (
        (!('superAdmin' in request.resource.data) || request.resource.data.superAdmin == false || isSuperAdmin()) &&
        (!('hidden' in request.resource.data) || request.resource.data.hidden == false || isSuperAdmin()) &&
        ((!('role' in request.resource.data)) || request.resource.data.role != 'super_admin' || isSuperAdmin()) &&
        (
          (request.auth.uid == userId &&
           request.resource.data.role == 'user' &&
           request.resource.data.blocked == false &&
           request.resource.data.isActive == true &&
           !('permissions' in request.resource.data))
          || (isChiefAdmin() && request.resource.data.role in ['admin', 'chief_admin', 'CHIEF_ADMIN', 'moderator', 'user'])
          || (isAdmin() && request.resource.data.role in ['moderator', 'user'])
        )
      );

      // UPDATE:
      // - Super Admin can toggle hidden visibility on ANY account (including self and other Super Admins),
      //   strictly restricted to the visibility field ('hidden' and 'updatedAt')
      // - Super Admin or authorized admins can make standard profile updates (neither hidden nor superAdmin can be changed)
      // - Lower roles cannot modify or grant superAdmin status, hidden status, or role='super_admin'
      // - Lower roles cannot update hidden accounts
      allow update: if isAuthenticated() && (
        // Branch 1: Super Admin toggling hidden visibility on ANY account
        (isSuperAdmin() &&
         request.resource.data.diff(resource.data).affectedKeys().hasAny(['hidden']) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden', 'updatedAt'])) ||

        // Branch 2: Standard profile updates (neither hidden nor superAdmin can be changed)
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['hidden', 'superAdmin']) && (
          isSuperAdmin() ||
          (!isSuperAdminAccount(userId) &&
           (!('hidden' in resource.data) || resource.data.hidden != true) &&
           (!('role' in request.resource.data) || request.resource.data.role != 'super_admin') && (
             (isChiefAdmin() && (!('role' in request.resource.data) || request.resource.data.role in ['chief_admin', 'CHIEF_ADMIN', 'admin', 'moderator', 'user'])) ||
             (isAdmin() && (!('role' in request.resource.data) || request.resource.data.role in ['moderator', 'user'] || request.resource.data.role == resource.data.role)) ||
             (request.auth.uid == userId &&
              resource.data.blocked != true &&
              resource.data.isActive != false &&
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'blocked', 'isActive', 'permissions', 'superAdmin', 'hidden']))
           )
          )
        ))
      );

      // DELETE:
      // - Super Admin can delete accounts
      // - Admins/Chief Admins can delete non-Super Admin, non-hidden accounts only
      allow delete: if isSuperAdmin() || (isAdmin() && !isSuperAdminAccount(userId) && (!('hidden' in resource.data) || resource.data.hidden != true));
    }

    // ============================================
    // COMPLAINTS COLLECTION
    // ============================================
    match /complaints/{complaintId} {
      // CREATE: Allowed for public guests & authenticated users when license is valid (or Super Admin)
      allow create: if (!isLicenseExpired() || isSuperAdmin()) &&
        request.resource.data.keys().hasAll([
          'ticketId', 'name', 'email', 'phone', 'employeeId', 'department',
          'designation', 'category', 'title', 'description', 'priority', 'status', 'createdAt'
        ]) && request.resource.data.status == 'pending';

      // READ: Restricted strictly to authenticated authorized staff or complainant
      // - Super Admin & Admins can read all complaints (get and list)
      // - Moderators can read ONLY complaints assigned to their own UID (if not hidden)
      // - Authenticated complainants can read their own complaints
      // - Unauthenticated reads are STRICTLY DENIED (no public direct read on complaint documents)
      allow get: if isAuthenticated() && (
        isSuperAdmin() ||
        isAdmin() ||
        (isModerator() && !isCallerHidden() && resource.data.assignedToUID == request.auth.uid) ||
        (resource.data.uid == request.auth.uid ||
         (('userEmail' in resource.data) && resource.data.userEmail == request.auth.token.email) ||
         (('email' in resource.data) && resource.data.email == request.auth.token.email))
      );
      allow list: if isAuthenticated() && (
        isSuperAdmin() ||
        isAdmin() ||
        (isModerator() && !isCallerHidden() && resource.data.assignedToUID == request.auth.uid) ||
        (resource.data.uid == request.auth.uid ||
         (('userEmail' in resource.data) && resource.data.userEmail == request.auth.token.email) ||
         (('email' in resource.data) && resource.data.email == request.auth.token.email))
      );

      // UPDATE: Restricted to authorized staff (when license is valid, or Super Admin; hidden moderator denied)
      // Moderators can update ONLY complaints assigned to their own UID
      allow update: if isSuperAdmin() || (!isLicenseExpired() && (
        isAdmin() ||
        (isModerator() && !isCallerHidden() && resource.data.assignedToUID == request.auth.uid)
      ));

      // DELETE: Admin only
      allow delete: if isAdmin() || isSuperAdmin();

      // ============================================
      // COMPLAINT NOTES SUBCOLLECTION
      // ============================================
      match /notes/{noteId} {
        // READ: Authorized staff (moderator restricted to assigned complaint and not hidden); Complainant can read adminToUser notes
        allow read: if isAuthenticated() && (
                       isSuperAdmin() ||
                       isAdmin() ||
                       (isModerator() && !isCallerHidden() && get(/databases/$(database)/documents/complaints/$(complaintId)).data.assignedToUID == request.auth.uid) ||
                       (resource.data.noteType == 'adminToUser' && (
                         get(/databases/$(database)/documents/complaints/$(complaintId)).data.uid == request.auth.uid ||
                         get(/databases/$(database)/documents/complaints/$(complaintId)).data.userEmail == request.auth.token.email
                       ))
                     );

        // CREATE: Authorized staff only (moderator restricted to assigned complaint and not hidden); Author email must match logged-in user (when license valid or Super Admin)
        allow create: if isSuperAdmin() || (((!isLicenseExpired() && (
          isAdmin() ||
          (isModerator() && !isCallerHidden() && get(/databases/$(database)/documents/complaints/$(complaintId)).data.assignedToUID == request.auth.uid)
        ))) &&
          request.resource.data.keys().hasAll(['noteType', 'content', 'authorEmail', 'authorName', 'createdAt']) &&
          request.resource.data.authorEmail == request.auth.token.email &&
          request.resource.data.noteType in ['adminToModerator', 'moderatorToAdmin', 'adminToUser']);

        // UPDATE: Notes are immutable audit logs
        allow update: if false;

        // DELETE: Admin only
        allow delete: if isAdmin() || isSuperAdmin();
      }
    }

    // ============================================
    // PUBLIC TRACKING COLLECTION (Secure Minimal Tracking Path)
    // ============================================
    match /publicTracking/{trackingKey} {
      // Direct get is allowed ONLY by exact non-guessable tracking key
      allow get: if true;
      // Listing or querying the collection is strictly denied
      allow list: if false;
      // Creation allowed during complaint filing (guest or authenticated)
      // Must contain only minimal allowed fields and cannot contain PII
      allow create: if (!isLicenseExpired() || isSuperAdmin()) &&
        request.resource.data.keys().hasAll(['ticketId', 'trackingSecret', 'status', 'createdAt', 'updatedAt']) &&
        !request.resource.data.keys().hasAny([
          'name', 'email', 'phone', 'employeeId', 'description', 'qtrNo',
          'personalNo', 'notes', 'userEmail', 'uid', 'imageUrl'
        ]);
      // Status updates allowed by authorized staff (Super Admin, Admin, or assigned Moderator)
      allow update: if isSuperAdmin() || (!isLicenseExpired() && (
        isAdmin() ||
        (isModerator() && !isCallerHidden() &&
         exists(/databases/$(database)/documents/complaints/$(request.resource.data.ticketId)) &&
         get(/databases/$(database)/documents/complaints/$(request.resource.data.ticketId)).data.assignedToUID == request.auth.uid)
      ));
      // Deletion by admin only
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ============================================
    // SYSTEM SETTINGS / SERVICE LICENSE
    // ============================================
    match /systemSettings/{configDoc} {
      // License configuration is publicly readable so clients can evaluate expiration
      allow read: if true;
      // Write and state modification strictly restricted to verified Super Admin custom claim
      allow write: if isSuperAdmin();
    }

    // ============================================
    // NOTIFICATIONS COLLECTION
    // ============================================
    match /notifications/{notificationId} {
      // READ: Users can only read notifications directed to their email
      allow read: if isAuthenticated() && resource.data.userEmail == request.auth.token.email;

      // CREATE: Authenticated users / staff
      allow create: if isAuthenticated();

      // UPDATE: Mark as read only
      allow update: if isAuthenticated() &&
                     resource.data.userEmail == request.auth.token.email &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt']);

      // DELETE: Recipient user or Admin
      allow delete: if isAuthenticated() && (
        resource.data.userEmail == request.auth.token.email || isAdmin()
      );
    }

    // ============================================
    // COUNTERS COLLECTION
    // ============================================
    match /counters/{counterId} {
      allow read: if true;

      // Atomic increments allowed for ticket creation and staff dashboard counters
      allow create, update: if (
        counterId == 'tickets' ||
        counterId == 'stats'
      );
    }

    // ============================================
    // RATE LIMITS COLLECTION (24h Submission Lock)
    // ============================================
    match /rateLimits/{lockId} {
      allow read: if true;

      // Rate limit locks can only be written if timestamp matches request.time
      allow write: if (lockId.matches('^email_.*') || lockId.matches('^phone_.*'))
                   && request.resource.data.keys().hasOnly(['lastSubmittedAt'])
                   && request.resource.data.lastSubmittedAt == request.time;
    }

    // ============================================
    // DENY ALL OTHER COLLECTIONS
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
