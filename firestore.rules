rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS (Strict Authoritative Custom Claims)
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Super Admin strictly authorized via Firebase Auth custom claim only
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.superAdmin == true;
    }

    // Admin authorized via custom claim, Chief Admin, Super Admin, or verified Firestore admin profile
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'chief_admin' ||
        request.auth.token.role == 'CHIEF_ADMIN' ||
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'chief_admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CHIEF_ADMIN') &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive != false &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blocked != true)
      );
    }

    // Chief Admin authorized via custom claim, Super Admin, or verified Firestore chief_admin profile
    function isChiefAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'chief_admin' ||
        request.auth.token.role == 'CHIEF_ADMIN' ||
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'chief_admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CHIEF_ADMIN') &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive != false &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blocked != true)
      );
    }

    // Moderator authorized via custom claim, Admin, Chief Admin, or Super Admin
    function isModerator() {
      return isAuthenticated() && (
        request.auth.token.role == 'moderator' ||
        isAdmin()
      );
    }

    // System license check for write operations
    function isLicenseExpired() {
      return exists(/databases/$(database)/documents/systemSettings/serviceLicense) &&
             get(/databases/$(database)/documents/systemSettings/serviceLicense).data.enabled == true &&
             request.time >= get(/databases/$(database)/documents/systemSettings/serviceLicense).data.expiresAt;
    }

    // Helper to identify Super Admin accounts across Firestore doc attributes and trusted registry
    function isSuperAdminAccount(userId) {
      return resource.data.superAdmin == true ||
             resource.data.role == 'super_admin' ||
             (exists(/databases/$(database)/documents/systemSettings/superAdminRegistry) &&
              userId in get(/databases/$(database)/documents/systemSettings/superAdminRegistry).data.uids);
    }

    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      // GET: Direct document lookup
      // - Users can read their own profile (including Super Admin)
      // - Super Admin can read any profile
      // - Admins & Chief Admins can read any non-Super Admin profile
      // - Moderators can read any non-Super Admin moderator profile
      allow get: if isAuthenticated() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (isAdmin() && !isSuperAdminAccount(userId)) ||
        (resource.data.role == 'moderator' && isModerator() && !isSuperAdminAccount(userId))
      );

      // LIST: Collection queries
      // - Super Admin can list all users directly
      // - Authenticated staff can query moderators
      // - General collection queries by lower roles are rejected (they must use the secure server-side getManagedUsers function)
      allow list: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource.data.role == 'moderator' && isModerator())
      );

      // CREATE:
      // - Regular users create own profile on registration strictly with role='user'
      // - Chief Admin can create Admin, Chief Admin, and Moderator accounts
      // - Admin can create Moderator and user accounts
      // - Lower roles can NEVER create accounts with superAdmin=true or role='super_admin'
      allow create: if isAuthenticated() && (
        (!('superAdmin' in request.resource.data) || request.resource.data.superAdmin == false || isSuperAdmin()) &&
        ((!('role' in request.resource.data)) || request.resource.data.role != 'super_admin' || isSuperAdmin()) &&
        (
          (request.auth.uid == userId &&
           request.resource.data.role == 'user' &&
           request.resource.data.blocked == false &&
           request.resource.data.isActive == true &&
           !('permissions' in request.resource.data))
          || (isChiefAdmin() && request.resource.data.role in ['admin', 'chief_admin', 'CHIEF_ADMIN', 'moderator', 'user'])
          || (isAdmin() && request.resource.data.role in ['moderator', 'user'])
        )
      );

      // UPDATE:
      // - Super Admin can update any profile (and only Super Admin can touch a Super Admin account)
      // - Chief Admin can update non-Super Admin profiles and assign roles
      // - Admin can update non-Super Admin profiles or assign moderator/user roles
      // - Users can update their own non-sensitive profile info only
      // - Lower roles cannot modify or grant superAdmin status or role='super_admin'
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (!isSuperAdminAccount(userId) &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['superAdmin']) &&
         (!('role' in request.resource.data) || request.resource.data.role != 'super_admin') && (
           (isChiefAdmin() && (!('role' in request.resource.data) || request.resource.data.role in ['chief_admin', 'CHIEF_ADMIN', 'admin', 'moderator', 'user'])) ||
           (isAdmin() && (!('role' in request.resource.data) || request.resource.data.role in ['moderator', 'user'] || request.resource.data.role == resource.data.role)) ||
           (request.auth.uid == userId &&
            resource.data.blocked != true &&
            resource.data.isActive != false &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'blocked', 'isActive', 'permissions', 'superAdmin']))
        ))
      );

      // DELETE:
      // - Super Admin can delete accounts
      // - Admins/Chief Admins can delete non-Super Admin accounts only
      allow delete: if isSuperAdmin() || (isAdmin() && !isSuperAdminAccount(userId));
    }

    // ============================================
    // COMPLAINTS COLLECTION
    // ============================================
    match /complaints/{complaintId} {
      // CREATE: Allowed for public guests & authenticated users when license is valid (or Super Admin)
      allow create: if (!isLicenseExpired() || isSuperAdmin()) &&
        request.resource.data.keys().hasAll([
          'ticketId', 'name', 'email', 'phone', 'employeeId', 'department',
          'designation', 'category', 'title', 'description', 'priority', 'status', 'createdAt'
        ]) && request.resource.data.status == 'pending';

      // READ: Single complaint trackable by ID; Full listing restricted to staff
      allow get: if true;
      allow list: if isModerator() || isAdmin();

      // UPDATE: Restricted to authorized staff (when license is valid, or Super Admin)
      allow update: if (!isLicenseExpired() && (isModerator() || isAdmin())) || isSuperAdmin();

      // DELETE: Admin only
      allow delete: if isAdmin() || isSuperAdmin();

      // ============================================
      // COMPLAINT NOTES SUBCOLLECTION
      // ============================================
      match /notes/{noteId} {
        // READ: Staff can read notes; AdminToUser notes can be viewed by submitter/guest via complaint view
        allow read: if isModerator() || isAdmin() || resource.data.noteType == 'adminToUser';

        // CREATE: Authorized staff only; Author email must match logged-in user (when license valid or Super Admin)
        allow create: if ((!isLicenseExpired() && (isModerator() || isAdmin())) || isSuperAdmin()) &&
          request.resource.data.keys().hasAll(['noteType', 'content', 'authorEmail', 'authorName', 'createdAt']) &&
          request.resource.data.authorEmail == request.auth.token.email &&
          request.resource.data.noteType in ['adminToModerator', 'moderatorToAdmin', 'adminToUser'];

        // UPDATE: Notes are immutable audit logs
        allow update: if false;

        // DELETE: Admin only
        allow delete: if isAdmin() || isSuperAdmin();
      }
    }

    // ============================================
    // SYSTEM SETTINGS / SERVICE LICENSE
    // ============================================
    match /systemSettings/{configDoc} {
      // License configuration is publicly readable so clients can evaluate expiration
      allow read: if true;
      // Write and state modification strictly restricted to verified Super Admin custom claim
      allow write: if isSuperAdmin();
    }

    // ============================================
    // NOTIFICATIONS COLLECTION
    // ============================================
    match /notifications/{notificationId} {
      // READ: Users can only read notifications directed to their email
      allow read: if isAuthenticated() && resource.data.userEmail == request.auth.token.email;

      // CREATE: Authenticated users / staff
      allow create: if isAuthenticated();

      // UPDATE: Mark as read only
      allow update: if isAuthenticated() &&
                     resource.data.userEmail == request.auth.token.email &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt']);

      // DELETE: Recipient user or Admin
      allow delete: if isAuthenticated() && (
        resource.data.userEmail == request.auth.token.email || isAdmin()
      );
    }

    // ============================================
    // COUNTERS COLLECTION
    // ============================================
    match /counters/{counterId} {
      allow read: if true;

      // Atomic increments allowed for ticket creation and staff dashboard counters
      allow create, update: if (
        counterId == 'tickets' ||
        counterId == 'stats'
      );
    }

    // ============================================
    // RATE LIMITS COLLECTION (24h Submission Lock)
    // ============================================
    match /rateLimits/{lockId} {
      allow read: if true;

      // Rate limit locks can only be written if timestamp matches request.time
      allow write: if (lockId.matches('^email_.*') || lockId.matches('^phone_.*'))
                   && request.resource.data.keys().hasOnly(['lastSubmittedAt'])
                   && request.resource.data.lastSubmittedAt == request.time;
    }

    // ============================================
    // DENY ALL OTHER COLLECTIONS
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
